  "repository": {
    "type": "git",
    "url": "git+https://github.com/xcdtasif/ph-se-07-033-ba.git"
  },
  "directories": {
    "doc": "docs"
  },
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "start": "node dist/server.js",
    "db:migrate": "prisma format && prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx src/db/seed.ts",
    "db:delete": "tsx src/db/delete.ts",
    "db:reseed": "npm run db:delete && npm run db:seed",
    "fmt": "oxfmt",
    "lint": "oxlint --fix",
    "stripe:listen": "dotenv run -f .env.local -- sh -c 'stripe listen --events checkout.session.completed,checkout.session.expired --forward-to localhost:$PORT/api/stripe/webhook'",
    "vc:env-sync": "bash scripts/vercel-env-sync.sh"
  },
  "dependencies": {
    "@prisma/adapter-neon": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "http-status": "^2.1.0",
    "jsonwebtoken": "^9.0.3",
    "ms": "^2.1.3",
    "stripe": "~22.3.2",
    "uploadthing": "^7.7.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.17.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prisma": "^7.10.1",
    "prisma-erd-generator": "^3.2.1",
    "puppeteer": "^25.16.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "24.x"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true,
    "puppeteer@25.16.0": true,
    "msgpackr-extract@3.0.7": true
  }
